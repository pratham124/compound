# Copy to .env (git-ignored) before `pnpm stack:up`. These are local-only placeholders.
POSTGRES_USER=compound
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=compound
# Host port for Postgres; 5433 so it does not clash with a Postgres already installed on the laptop.
POSTGRES_PORT=5433
# Host port for Valkey; 6380 so it does not clash with a Redis already installed on the laptop.
VALKEY_PORT=6380

# The server runs on the host and reads these. DATABASE_URL must use the password and port above, and VALKEY_URL the Valkey port.
DATABASE_URL=postgres://compound:change-me-locally@localhost:5433/compound
VALKEY_URL=redis://localhost:6380
SQS_ENDPOINT=http://localhost:9324
# The emulator ignores credentials but the AWS SDK needs some set.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
