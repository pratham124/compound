{
  "name": "compound",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings .",
    "typecheck": "pnpm -r typecheck",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down",
    "test:non-superuser": "node --env-file=.env.example --env-file-if-exists=.env scripts/test-as-non-superuser.mjs",
    "test": "pnpm -r test && node --test \"infra/local/*.test.ts\" \"scripts/verification/*.test.mjs\" \".claude/skills/verify-compound/scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007"
  }
}
