{
  "name": "@compound/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=../../.env src/server.ts",
    "dev": "node --env-file=../../.env --watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file=../../.env.example --env-file-if-exists=../../.env --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1168.0",
    "@compound/contracts": "workspace:*",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "typescript": "~6.0.3"
  }
}
