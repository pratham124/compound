{
  "expo": {
    "name": "Compound",
    "slug": "compound",
    "scheme": "compound",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "../../docs/brand/app-icon/icon.png",
    "ios": {
      "bundleIdentifier": "com.pratham124.compound",
      "supportsTablet": false,
      "icon": {
        "light": "../../docs/brand/app-icon/icon.png",
        "dark": "../../docs/brand/app-icon/icon-dark.png",
        "tinted": "../../docs/brand/app-icon/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pratham124.compound",
      "adaptiveIcon": {
        "foregroundImage": "../../docs/brand/app-icon/android-icon-foreground.png",
        "backgroundImage": "../../docs/brand/app-icon/android-icon-background.png",
        "monochromeImage": "../../docs/brand/app-icon/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "../../docs/brand/app-icon/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "../../docs/brand/app-icon/splash-icon.png",
          "backgroundColor": "#EDF3F0",
          "dark": {
            "image": "../../docs/brand/app-icon/splash-icon-dark.png",
            "backgroundColor": "#191614"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6d7f289b-e229-41c0-997d-711091d7da7c"
      }
    },
    "owner": "pfrog123"
  }
}
